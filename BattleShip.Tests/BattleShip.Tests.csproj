<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.83.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleShip.API\BattleShip.API.csproj" />
    <!-- Les règles d'écran (quelle longueur reste choisie, comment un refus est lu) sont testables
         sans rendu : bUnit reste écarté, c'est le visuel qui n'est pas couvert.
         Alias obligatoire : l'API et l'App génèrent toutes deux les types de battleship.proto,
         et sans lui BattleShip.Protocol.GameService devient ambigu (CS0433). -->
    <ProjectReference Include="..\BattleShip.App\BattleShip.App.csproj" Aliases="app" />
  </ItemGroup>
</Project>