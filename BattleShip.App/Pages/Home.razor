@page "/"
@using BattleShip.App.Services
@using BattleShip.Models
@using BattleShip.Models.Dtos
@using Microsoft.JSInterop
@inject GameApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Bataille navale</PageTitle>

<div class="home-heading">
    <p class="home-kicker">Centre de commandement</p>
    <h1>Bataille navale</h1>
    <p>Une partie contre l'ordinateur, sur une grille de 10 × 10. Les flottes sont placées par le serveur.</p>
</div>

<div class="new-game-controls">
    <button class="new-game-button home-new-game" @onclick="NewGame" disabled="@creating">
        <span class="new-game-icon" aria-hidden="true">+</span>
        <span>@(creating ? "Création en cours..." : "Nouvelle partie")</span>
    </button>
</div>

@if (loading)
{
    <div class="app-loading" role="status">
        <span class="loading-orbit" aria-hidden="true"></span>
        <p>Chargement des parties…</p>
    </div>
}
else if (games.Any())
{
    <section class="game-history-section">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Continuer</p>
                <h2>Parties en cours</h2>
            </div>
            <span class="section-count">@ActiveGames.Count()</span>
        </div>
        @if (!ActiveGames.Any())
        {
            <p class="empty-history">Aucune partie en cours.</p>
        }
        else
        {
            <div class="game-list">
                @foreach (var game in ActiveGames)
                {
                    <div class="game-row">
                        <div class="game-info">
                            <span class="game-status status-active">En cours</span>
                            <span class="game-date">@game.CreatedAt.LocalDateTime.ToString("g")</span>
                        </div>
                        <a class="game-action" href="@($"/partie/{game.Id}")">Reprendre <span aria-hidden="true">→</span></a>
                    </div>
                }
            </div>
        }
    </section>

    <section class="game-history-section">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Archives</p>
                <h2>Historique</h2>
            </div>
            <span class="section-count">@FinishedGames.Count()</span>
        </div>
        @if (!FinishedGames.Any())
        {
            <p class="empty-history">Aucune partie terminée.</p>
        }
        else
        {
            <div class="game-list">
                @foreach (var game in FinishedGames)
                {
                    <div class="game-row">
                        <div class="game-info">
                            <span class="game-status @(game.Winner == Side.Player ? "status-win" : "status-loss")">@(game.Winner == Side.Player ? "Victoire" : "Défaite")</span>
                            <span class="game-date">@game.CreatedAt.LocalDateTime.ToString("g")</span>
                        </div>
                        <a class="game-action" href="@($"/partie/{game.Id}")">Voir <span aria-hidden="true">→</span></a>
                    </div>
                }
            </div>
        }
    </section>
}

@if (error is not null)
{
    <p role="alert">@error</p>
}

@code {
    private bool creating;
    private bool loading = true;
    private string? error;
    private IReadOnlyList<GameSummaryDto> games = [];

    private IEnumerable<GameSummaryDto> ActiveGames => games.Where(game => game.Phase != GamePhase.Finished);
    private IEnumerable<GameSummaryDto> FinishedGames => games.Where(game => game.Phase == GamePhase.Finished);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            games = await Api.ListAsync();
        }
        catch (HttpRequestException exception)
        {
            error = $"Le serveur ne répond pas : {exception.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task NewGame()
    {
        creating = true;
        error = null;
        await Js.InvokeVoidAsync("battleMusic", false);

        try
        {
            var result = await Api.CreateAsync();
            if (result.Game is { } game)
            {
                Navigation.NavigateTo($"/partie/{game.Id}");
                return;
            }

            error = result.Refusal;
        }
        catch (HttpRequestException exception)
        {
            // Réponse d'erreur : lue par CreateAsync. Ici, c'est l'absence de réponse — API arrêtée.
            error = $"Le serveur ne répond pas : {exception.Message}";
        }

        creating = false;
    }
}
