@page "/partie/{Id}"
@using BattleShip.App.Components
@using BattleShip.App.Services
@using BattleShip.Models
@using BattleShip.Models.Dtos
@* Alias : BattleShip.Protocol et BattleShip.Models déclarent tous deux Coordinate, GamePhase et Side. *@
@using Proto = BattleShip.Protocol
@using Grpc.Core
@inject GameApiClient Api
@inject Proto.GameService.GameServiceClient GameClient
@inject NavigationManager Navigation
@inject GameAudio Audio

<PageTitle>Partie @Id</PageTitle>

@if (error is not null)
{
    <p role="alert">@error</p>
    <button class="new-game-button new-game-button-secondary" data-sound="primary" @onclick="NewGame">
        <span class="new-game-icon new-game-icon-plus" aria-hidden="true"></span>
        <span>Nouvelle partie</span>
    </button>
}
else if (state is null)
{
    <div class="app-loading game-loading" role="status">
        <span class="loading-orbit" aria-hidden="true"></span>
        <p>Chargement de la partie…</p>
    </div>
}
else
{
    @if (state.Phase == GamePhase.Finished)
    {
        @* Overlay plutôt qu'un bloc dans le fil de la page : la grille finale reste visible
           derrière, et rien ne se décale — seul l'écran se recouvre, jamais la mise en page. *@
        <div class="outcome-overlay">
            <div class="outcome-card @(state.Winner == Side.Player ? "outcome-win" : "outcome-loss")">
                <span class="outcome-mark" aria-hidden="true">@(state.Winner == Side.Player ? "✓" : "×")</span>
                <h2>@(state.Winner == Side.Player ? "Tu as gagné." : "L'ordinateur a gagné.")</h2>
                <p>@(state.Winner == Side.Player ? "La flotte adverse est vaincue." : "Ta flotte a été entièrement touchée.")</p>
                <div class="outcome-stats">
                    <span><strong>@state.Statistics.TotalShots</strong> tirs</span>
                    <span><strong>@state.Statistics.SuccessfulShots</strong> touches</span>
                    <span><strong>@state.Statistics.AccuracyPercentage%</strong> précision</span>
                    <span><strong>@FormatDuration(state.Statistics.DurationSeconds)</strong> durée</span>
                </div>
                <button class="new-game-button new-game-button-secondary" data-sound="primary" @onclick="NewGame">
                    <span class="new-game-icon new-game-icon-plus" aria-hidden="true"></span>
                    <span>Nouvelle partie</span>
                </button>
            </div>
        </div>
    }
    else
    {
        @* Pendant la préparation, personne n'a la main : CurrentTurn est null, et annoncer
           « L'ordinateur joue » serait faux. *@
        <div class="turn-banner @(state.CurrentTurn == Side.Computer ? "turn-computer" : "turn-player")">
            <span class="turn-dot" aria-hidden="true"></span>
            <p class="turn-label">
                @(state.CurrentTurn switch
                {
                    Side.Player => "À ton tour",
                    Side.Computer => "L'ordinateur joue",
                    _ => "Prépare ta flotte",
                })
            </p>
        </div>

        @if (state.Phase == GamePhase.Setup)
        {
            <div class="preparation-bar">
                <div class="status-copy">
                    @if (state.Player.RemainingShipLengths.Count == 0)
                    {
                        <strong class="fleet-ready">Flotte complète. Tu peux commencer.</strong>
                    }
                    else
                    {
                        <span>Choisis un navire dans le port, ou clique un navire posé pour le reprendre en main. Molette pour l'orienter, clic sur la grille pour le poser.</span>
                    }
                </div>
                <div class="difficulty-control">
                    <label for="difficulty">Niveau de l'ordinateur</label>
                    <select id="difficulty" data-sound="select" value="@state.Difficulty" disabled="@busy"
                            @onchange="ChangeDifficulty">
                        <option value="@AiDifficulty.Easy">Facile</option>
                        <option value="@AiDifficulty.Normal">Normal</option>
                        <option value="@AiDifficulty.Hard">Difficile</option>
                    </select>
                </div>
                <div class="action-row">
                    <button class="ghost" data-sound="secondary" @onclick="PlaceFleetAtRandom" disabled="@busy">Placement aléatoire</button>
                    <button class="ghost" data-sound="destructive" @onclick="ResetFleet" disabled="@(busy || state.Player.Ships.Count == 0)">Réinitialiser</button>
                    <button class="primary" data-sound="primary" @onclick="Start" disabled="@(busy || state.Player.RemainingShipLengths.Count > 0)">Commencer</button>
                </div>
            </div>
        }
    }

    <button class="rules-button" data-sound="panel-open" @onclick="() => rulesOpen = true" aria-label="Règles du jeu" title="Règles du jeu">?</button>

    @* Un rappel des règles, pas une source de vérité : le serveur reste seul juge, et ce panneau
       ne fait qu'expliquer ce qu'il applique. *@
    @if (rulesOpen)
    {
        <div class="rules-overlay" @onclick="() => rulesOpen = false">
            <div class="rules-panel" role="dialog" aria-modal="true" aria-label="Règles du jeu" @onclick:stopPropagation>
                <div class="rules-header">
                    <h2>Règles</h2>
                    <button class="rules-close" data-sound="panel-close" @onclick="() => rulesOpen = false" aria-label="Fermer">×</button>
                </div>

                <section>
                    <h3>Le plateau</h3>
                    <p>
                        Une grille de @state.Player.Width × @state.Player.Height par camp, et la même
                        flotte des deux côtés : @FleetSummary().
                    </p>
                </section>

                <section>
                    <h3>Poser sa flotte</h3>
                    <p>
                        Un navire occupe une ligne droite, horizontale ou verticale. Il ne peut ni sortir
                        de la grille, ni en chevaucher un autre@(state.AllowAdjacentShips
                            ? ". Cette partie autorise deux navires à se toucher par un côté."
                            : ", ni en toucher un autre par un côté. Le contact en diagonale, lui, est permis.")
                    </p>
                </section>

                <section>
                    <h3>Commandes</h3>
                    <p>
                        Clique un navire du port pour le prendre en main, la molette l'oriente, un clic
                        sur la grille le pose. Clique un navire déjà posé pour le reprendre.
                        Le contour vert ou rouge vient du serveur : c'est lui qui accepte ou refuse.
                    </p>
                </section>

                <section>
                    <h3>Tirer</h3>
                    <p>
                        Désigne une case de la grille adverse : à l'eau, touché, ou coulé.
                        Tu gardes la main tant que tu touches ; un tir à l'eau la passe à l'ordinateur.
                        Rejouer une case déjà tirée est refusé et ne compte pas comme un coup.
                    </p>
                </section>

                @if (state.SpecialAttacksEnabled)
                {
                    <section>
                        <h3>Attaque spéciale</h3>
                        <p>
                            Chaque camp charge sa jauge d'une unité à chacun de ses tirs acceptés
                            (@state.SpecialAttackChargeInterval tirs pour une charge pleine, plafonnée à une seule).
                            Une fois chargée, ton tir suivant devient automatiquement une attaque spéciale — rien à
                            activer : elle touche une croix de cinq cases, la case visée et ses quatre voisines par
                            les côtés, en un seul coup, et consomme aussitôt la charge. Aux bords de la grille ou sur
                            une case déjà tirée, la voisine correspondante est simplement ignorée. Tu gardes la main
                            si au moins une des cases touchées est un touché ou un coulé. L'ordinateur suit
                            exactement la même règle et l'utilise automatiquement dès qu'il est chargé.
                        </p>
                    </section>
                }

                <section>
                    <h3>Gagner</h3>
                    <p>
                        Le premier qui coule toute la flotte adverse l'emporte, et la partie s'arrête
                        aussitôt, même au milieu d'une série.
                    </p>
                </section>

                <section>
                    <h3>Ce que tu ne vois pas</h3>
                    <p>
                        La position d'un navire adverse n'apparaît qu'une fois ce navire coulé. Tant
                        qu'il flotte, elle ne quitte jamais le serveur.
                    </p>
                </section>

                <section>
                    <h3>L'ordinateur</h3>
                    <p>
                        Il joue avec les mêmes règles que toi et ne sait rien de plus.
                        @(state.Difficulty switch
                        {
                            AiDifficulty.Easy => "Il tire entièrement au hasard, sans jamais viser deux fois la même case.",
                            AiDifficulty.Hard => "Pour chaque case libre, il évalue combien de placements de navires y sont encore compatibles avec ce qu'il sait, et vise la plus probable.",
                            _ => "Il tire au hasard, puis vise les cases voisines dès qu'il touche.",
                        })
                    </p>
                </section>

                <section>
                    <h3>Repères visuels</h3>
                    <p>
                        Sur ta grille, un contour distinct marque la dernière case où l'ordinateur a tiré :
                        pratique pour la retrouver après une série de plusieurs tirs d'affilée.
                    </p>
                </section>
            </div>
        </div>
    }

    @if (message is not null)
    {
        <p class="notice">@message</p>
    }

    @if (refusal is not null)
    {
        <p class="game-feedback game-feedback-refusal" role="alert">@refusal</p>
    }

    @* Un refus vient du serveur, une absence de réponse veut dire qu'il n'a rien dit : deux
       messages distincts, parce que l'un se corrige en jouant autrement et l'autre non. *@
    @if (unreachable is not null)
    {
        <p class="game-feedback game-feedback-refusal" role="alert">@unreachable</p>
    }

    @if (startCountdownText is not null)
    {
        <div class="start-banner" aria-hidden="true">
            <span class="start-banner-text @(startCountdownText == FireWord ? "fire" : null)" @key="startCountdownText">
                @startCountdownText
            </span>
        </div>
    }

    <div class="game-shell @(starting ? "game-starting" : null)">
        <aside class="game-sidebar">
            @if (state.Phase == GamePhase.Setup)
            {
                    <Port RemainingLengths="state.Player.RemainingShipLengths"
                        SelectedIndex="selectedPortIndex"
                      Orientation="orientation"
                      OnSelect="Select" />
            }

            <div class="hud-card">
                <h3>État</h3>
                @if (state.CurrentTurn is not null)
                {
                    <div class="hud-item">
                        <span>Tour</span>
                        <strong>@state.CurrentTurn</strong>
                    </div>
                }
                <div class="hud-item">
                    <span>Mes navires</span>
                    <strong>@RemainingPlayerShips</strong>
                </div>
                @if (state.Phase != GamePhase.Setup)
                {
                    <div class="hud-item">
                        <span>Navires adverses</span>
                        <strong>@RemainingOpponentShips</strong>
                    </div>
                }
                <div class="hud-item">
                    <span>Précision</span>
                    <strong>@state.Statistics.AccuracyPercentage%</strong>
                </div>
                <div class="hud-item">
                    <span>Coups</span>
                    <strong>@state.Statistics.TotalShots</strong>
                </div>
            </div>
            @if (state.Statistics.History.Count > 0)
            {
                <div class="hud-card shot-history">
                    <h3>Derniers tirs</h3>
                    @foreach (var shot in state.Statistics.History.TakeLast(5).Reverse())
                    {
                        <div class="history-item">
                            <span>@Name(shot.Target)</span>
                            <strong class="history-@shot.Outcome.ToString().ToLowerInvariant()">@Outcome(shot.Outcome)</strong>
                        </div>
                    }
                </div>
            }
        </aside>

        <div class="boards-area @(state.Phase == GamePhase.Setup ? "setup-mode" : "battle-mode")">
            @if (state.Phase != GamePhase.Setup)
            {
                <div class="board-panel board-panel-opponent">
                    @if (state.Phase == GamePhase.InProgress && state.SpecialAttacksEnabled)
                    {
                        <div class="special-attack-gauge @(PlayerSpecialAttackCharged ? "charged" : null)"
                             title="@(PlayerSpecialAttackCharged
                                 ? "Attaque spéciale prête : le prochain tir touchera une croix de 5 cases."
                                 : $"Attaque spéciale : {state.PlayerSpecialAttackProgress}/{state.SpecialAttackChargeInterval}")">
                            <span class="special-attack-symbol" aria-hidden="true">✦</span>
                            <span class="special-attack-pips">
                                @for (var i = 0; i < state.SpecialAttackChargeInterval; i++)
                                {
                                    var filled = i < state.PlayerSpecialAttackProgress;
                                    <span class="special-attack-pip @(filled ? "filled" : null)"></span>
                                }
                            </span>
                        </div>
                    }
                    <Grid Title="Grille adverse"
                          Width="state.Opponent.Width"
                          Height="state.Opponent.Height"
                          SunkShips="state.Opponent.SunkShips"
                          Misses="state.Opponent.Misses"
                          Hits="state.Opponent.Hits"
                          AnimatedCell="animatedCell"
                          AnimatedOutcome="animatedOutcome"
                          AnimatedSpecial="animatedSpecial"
                          Preview="OpponentPreview"
                          PreviewValid="true"
                          RootCssClass="@OpponentGridClass"
                          OnCellClick="Fire"
                          OnCellHover="ShowSpecialAttackPreview"
                          OnLeave="ClearSpecialAttackPreview" />
                </div>
            }

            <div class="board-panel board-panel-player">
                @if (state.Phase == GamePhase.InProgress && state.SpecialAttacksEnabled)
                {
                    <div class="special-attack-gauge computer @(state.ComputerSpecialAttackProgress >= state.SpecialAttackChargeInterval ? "charged" : null)"
                         title="@($"Attaque spéciale de l'ordinateur : {state.ComputerSpecialAttackProgress}/{state.SpecialAttackChargeInterval}")">
                        <span class="special-attack-symbol" aria-hidden="true">✦</span>
                        <span class="special-attack-pips">
                            @for (var i = 0; i < state.SpecialAttackChargeInterval; i++)
                            {
                                var filled = i < state.ComputerSpecialAttackProgress;
                                <span class="special-attack-pip @(filled ? "filled" : null)"></span>
                            }
                        </span>
                    </div>
                }
                <Grid Title="Ma grille"
                      Width="state.Player.Width"
                      Height="state.Player.Height"
                      Ships="VisibleShips"
                      SunkShips="state.Player.SunkShips"
                      Misses="state.Player.Misses"
                      Hits="state.Player.Hits"
                      AnimatedCell="animatedCell"
                      AnimatedOutcome="animatedOutcome"
                      AnimatedSpecial="animatedSpecial"
                      LastComputerShot="lastComputerShot"
                      Preview="preview"
                      PreviewValid="previewValid"
                      OnCellClick="PlaceShip"
                      OnCellHover="ShowPreview"
                      OnLeave="ClearHover"
                      OnWheel="RotateHeldShip"
                      RootCssClass="@(state.Phase == GamePhase.Setup ? "primary-grid" : "compact")" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private GameStateDto? state;
    private string? message;
    private string? refusal;
    private string? unreachable;
    private string? error;
    private bool busy;
    private bool starting;
    private bool rulesOpen;
    private int? selectedLength;
    private int? selectedPortIndex;
    private Orientation orientation = Orientation.Horizontal;
    private IReadOnlyCollection<Coordinate> preview = [];
    private bool previewValid;

    // Dernière case de ma grille survolée, ou null si la souris est sortie de la grille.
    private Coordinate? hoveredCell;
    private Coordinate? animatedCell;
    private ShotOutcome? animatedOutcome;
    private bool animatedSpecial;

    // Persiste au-delà de l'animation d'impact, contrairement à animatedCell : sert de repère
    // durable sur ma grille, pas d'un simple flash.
    private Coordinate? lastComputerShot;

    // Case de la grille adverse survolée, pour l'aperçu en croix : automatique dès que la jauge
    // est pleine, il n'y a rien d'autre à armer.
    private Coordinate? specialAttackHover;

    // Décompte affiché au centre de l'écran au démarrage : null tant qu'aucune manche n'est en
    // cours. Chaque étape a son propre son (PlayStartSequence) et sa propre durée d'affichage.
    private string? startCountdownText;
    private const string FireWord = "Feu !";

    private static readonly (string Text, TimeSpan Duration)[] StartCountdownSteps =
    [
        ("3", TimeSpan.FromMilliseconds(550)),
        ("2", TimeSpan.FromMilliseconds(550)),
        ("1", TimeSpan.FromMilliseconds(550)),
        (FireWord, TimeSpan.FromMilliseconds(650)),
    ];

    // Ne s'applique qu'au tout premier tir de l'ordinateur, quand il commence : sans lui, ce tir
    // peut s'afficher avant que l'écran ait fini de charger, et passe inaperçu. Les tirs suivants,
    // dans cette série ou dans une série ultérieure, gardent leur cadence normale (450 ms).
    private static readonly TimeSpan FirstComputerShotDelay = TimeSpan.FromSeconds(1);

    // Cases où le navire choisi tient, telles que le serveur les a calculées.
    private IReadOnlyList<Coordinate> validOrigins = [];

    private IReadOnlyCollection<Coordinate> OwnShipCells =>
        state is null ? [] : [.. state.Player.Ships.SelectMany(ship => ship)];

    private static readonly string[] FrenchCounts = ["zéro", "un", "deux", "trois"];

    // Décrit la flotte réellement demandée pour cette partie (personnalisée ou non), qu'elle soit
    // déjà posée, encore à poser, ou un mélange des deux — le panneau de règles doit rester vrai
    // à toutes les phases, pas seulement à la création.
    private string FleetSummary()
    {
        if (state is null)
            return "aucun navire";

        var lengths = state.Player.Ships.Select(ship => ship.Count).Concat(state.Player.RemainingShipLengths);
        var groups = lengths.GroupBy(length => length).OrderByDescending(group => group.Key).ToList();
        if (groups.Count == 0)
            return "aucun navire";

        var parts = groups.Select((group, index) =>
        {
            var count = group.Count();
            var mot = FrenchCounts[Math.Min(count, FrenchCounts.Length - 1)];
            return index == 0
                ? $"{mot} navire{(count > 1 ? "s" : "")} de {group.Key} case{(group.Key > 1 ? "s" : "")}"
                : $"{mot} de {group.Key}";
        }).ToList();

        return parts.Count == 1 ? parts[0] : string.Join(", ", parts[..^1]) + " et " + parts[^1];
    }

    private int RemainingPlayerShips => state is null
        ? 0
        : state.Phase == GamePhase.Setup
            ? state.Player.Ships.Count + state.Player.RemainingShipLengths.Count
            : state.Player.Ships.Count - state.Player.SunkShips.Count;

    private int RemainingOpponentShips => state is null
        ? 0
        : 5 - state.Opponent.SunkShips.Count;

    private IReadOnlyList<IReadOnlyList<Coordinate>> VisibleShips => state?.Player.Ships ?? [];

    private bool PlayerSpecialAttackCharged =>
        state is not null && state.PlayerSpecialAttackProgress >= state.SpecialAttackChargeInterval;

    // Le contour pointillé signale que la jauge est prête : automatique, dès qu'elle l'est, le
    // prochain clic devient l'attaque spéciale de lui-même — il n'y a plus de mode à armer.
    private string OpponentGridClass =>
        (busy || state?.CurrentTurn != Side.Player ? "primary-grid grid-locked" : "primary-grid")
        + (PlayerSpecialAttackCharged ? " mode-speciale" : string.Empty);

    // Reflète honnêtement ce que le serveur résoudra : les voisines hors grille ou déjà tirées
    // sont exclues ici aussi, pour ne pas promettre une case que l'attaque va en fait ignorer.
    private IReadOnlyCollection<Coordinate> OpponentPreview =>
        PlayerSpecialAttackCharged && specialAttackHover is { } hover ? SpecialAttackCross(hover) : [];

    private IReadOnlyList<Coordinate> SpecialAttackCross(Coordinate center)
    {
        if (state is null)
            return [];

        var width = state.Opponent.Width;
        var height = state.Opponent.Height;
        var alreadyTargeted = state.Opponent.Misses
            .Concat(state.Opponent.Hits)
            .Concat(state.Opponent.SunkShips.SelectMany(ship => ship))
            .ToHashSet();

        Coordinate[] candidates =
        [
            center,
            center with { Column = center.Column - 1 },
            center with { Column = center.Column + 1 },
            center with { Row = center.Row - 1 },
            center with { Row = center.Row + 1 },
        ];

        return [.. candidates.Where(cell =>
            cell.Column >= 0 && cell.Column < width && cell.Row >= 0 && cell.Row < height
            && !alreadyTargeted.Contains(cell))];
    }

    private void ShowSpecialAttackPreview(Coordinate cell) => specialAttackHover = cell;

    private void ClearSpecialAttackPreview() => specialAttackHover = null;

    // L'ambiance suit la phase : le combat commence quand la partie commence, et retombe à la
    // fin. Le service ne traverse l'interop que sur un vrai changement.
    protected override Task OnAfterRenderAsync(bool firstRender) =>
        Audio.SetMoodAsync(state?.Phase == GamePhase.InProgress ? "combat" : "calm");

    protected override Task OnParametersSetAsync()
    {
        message = null;
        refusal = null;
        // Blazor réutilise cette instance de page en changeant seulement Id (ex. « Nouvelle
        // partie ») : sans ça, un survol resterait mémorisé d'une partie à l'autre.
        specialAttackHover = null;
        return LoadState();
    }

    // Lecture de l'état par gRPC-Web : c'est ce chemin qui permet de reprendre la partie après un rechargement.
    private async Task LoadState()
    {
        state = null;
        error = null;

        try
        {
            var response = await GameClient.GetGameAsync(new Proto.GetGameRequest { GameId = Id });
            state = GameStateConverter.ToDto(response);
            preview = [];
            KeepSelectionValid();
            await RefreshValidOrigins();
        }
        catch (RpcException failure) when (failure.StatusCode == StatusCode.NotFound)
        {
            error = "Cette partie n'existe plus sur le serveur. Crée une nouvelle partie.";
        }
        catch (RpcException failure) when (failure.StatusCode == StatusCode.InvalidArgument)
        {
            error = $"Identifiant refusé : {failure.Status.Detail}";
        }
        catch (RpcException failure)
        {
            error = $"Lecture de la partie en échec ({failure.StatusCode}) : {failure.Status.Detail}";
        }
    }

    private async Task Select(int index)
    {
        if (state is null || index < 0 || index >= state.Player.RemainingShipLengths.Count)
            return;

        var length = state.Player.RemainingShipLengths[index];
        selectedLength = length;
        selectedPortIndex = index;
        preview = [];
        await RefreshValidOrigins();
    }

    // La molette n'agit que sur le navire qu'on a en main. Un navire posé sur la grille ne pivote
    // jamais sous la molette : il faut d'abord le reprendre en cliquant dessus.
    private async Task RotateHeldShip(Coordinate _)
    {
        if (state?.Phase != GamePhase.Setup || selectedLength is null)
            return;

        await ToggleOrientation();
    }

    private async Task ToggleOrientation()
    {
        if (state?.Phase != GamePhase.Setup)
            return;

        orientation = orientation == Orientation.Horizontal ? Orientation.Vertical : Orientation.Horizontal;
        preview = [];
        await RefreshValidOrigins();

        // La souris est restée sur la même case : aucun survol ne sera émis, c'est donc ici qu'il
        // faut redessiner, sinon l'aperçu ne revient qu'en changeant de case.
        if (hoveredCell is { } cell)
            ShowPreview(cell);
    }

    private IReadOnlyList<Coordinate> PreviewCellsForSelectedShip(Coordinate origin, int length)
    {
        return [.. Enumerable.Range(0, length).Select(offset => orientation == Orientation.Horizontal
            ? origin with { Column = origin.Column + offset }
            : origin with { Row = origin.Row + offset })];
    }

    // La forme est dessinée ici pour l'aperçu, mais la couleur vient du serveur : le client ne
    // fait qu'une appartenance à la liste des origines valides qu'il a reçue.
    private void ShowPreview(Coordinate origin)
    {
        // Retenue avant tout le reste : c'est elle qui permet de redessiner l'aperçu après une
        // rotation, alors que la souris n'a pas changé de case et n'émettra donc aucun survol.
        hoveredCell = origin;

        if (state?.Phase != GamePhase.Setup)
        {
            preview = [];
            return;
        }

        if (selectedLength is not { } length)
        {
            preview = [];
            return;
        }

        var portPreview = PreviewCellsForSelectedShip(origin, length);
        var nextPreviewValid = validOrigins.Contains(origin);
        if (preview.SequenceEqual(portPreview) && previewValid == nextPreviewValid)
            return;

        preview = portPreview;
        previewValid = nextPreviewValid;
    }

    private void ClearHover()
    {
        hoveredCell = null;
        preview = [];
    }

    private async Task RefreshValidOrigins()
    {
        if (state?.Phase != GamePhase.Setup || selectedLength is not { } length)
        {
            validOrigins = [];
            return;
        }

        var result = await Answered(() => Api.ValidOriginsAsync(Guid.Parse(Id), length, orientation));
        if (result is null)
        {
            validOrigins = [];
            return;
        }

        validOrigins = result.Origins;

        // Sans origines, colorer l'aperçu en rouge serait un mensonge : on lâche la sélection,
        // ce qui supprime l'aperçu, et on affiche ce que le serveur a répondu.
        if (result.Refusal is { } refused)
        {
            selectedLength = null;
            preview = [];
            refusal = refused;
        }
    }

    // Un clic sur ma grille pose le navire qu'on a en main, ou reprend celui qui occupe la case.
    private async Task PlaceShip(Coordinate origin)
    {
        if (busy || state is null || state.Phase != GamePhase.Setup)
            return;

        if (state.Player.Ships.FirstOrDefault(ship => ship.Contains(origin)) is { } placed)
        {
            await PickUp(placed, origin);
            return;
        }

        if (selectedLength is { } length)
        {
            await Prepare(version => Api.PlaceShipAsync(Guid.Parse(Id), origin, length, orientation, version));
            selectedLength = null;
            selectedPortIndex = null;
            preview = [];
        }
    }

    // Reprendre un navire posé, c'est le retirer de la grille et le remettre en main : il revient
    // dans l'état d'un navire à poser, avec l'orientation qu'il avait. Rien n'est « déplacé » ni
    // « pivoté » sur le plateau — il n'y est plus tant qu'on ne l'a pas reposé.
    private async Task PickUp(IReadOnlyList<Coordinate> ship, Coordinate cell)
    {
        var length = ship.Count;
        var anchor = ShipAnchor(ship);

        await Prepare(version => Api.RemoveShipAsync(Guid.Parse(Id), cell, version));

        // Retrait refusé : il n'y a rien en main, et l'écran n'a pas bougé.
        if (state is null || !state.Player.RemainingShipLengths.Contains(length))
            return;

        selectedLength = length;
        selectedPortIndex = IndexOfLength(state.Player.RemainingShipLengths, length);
        orientation = ResolveOrientation(ship);

        await RefreshValidOrigins();

        // Le tracé réapparaît tout de suite à l'endroit d'où le navire vient, sans bouger la souris.
        // Sa couleur reste celle que le serveur dicte : on interroge la liste qu'il vient d'envoyer.
        preview = [.. ship];
        previewValid = validOrigins.Contains(anchor);
    }

    private static int? IndexOfLength(IReadOnlyList<int> lengths, int length)
    {
        for (var index = 0; index < lengths.Count; index++)
        {
            if (lengths[index] == length)
                return index;
        }

        return null;
    }

    private static Orientation ResolveOrientation(IReadOnlyList<Coordinate> ship)
        => ship.Count == 1 ? Orientation.Horizontal : ship.All(cell => cell.Row == ship[0].Row) ? Orientation.Horizontal : Orientation.Vertical;

    private static Coordinate ShipAnchor(IReadOnlyList<Coordinate> ship) =>
        ship.OrderBy(cell => cell.Row).ThenBy(cell => cell.Column).First();


    private Task PlaceFleetAtRandom() => Prepare(version => Api.PlaceFleetAtRandomAsync(Guid.Parse(Id), version));

    private Task ResetFleet() => Prepare(version => Api.ResetFleetAsync(Guid.Parse(Id), version));

    // Le niveau est une donnée de la partie, pas un réglage d'écran : c'est le serveur qui le
    // retient, et l'état relu après un rechargement le rapporte.
    private Task ChangeDifficulty(ChangeEventArgs change) =>
        Enum.TryParse<AiDifficulty>(change.Value?.ToString(), out var chosen)
            ? Prepare(version => Api.SetDifficultyAsync(Guid.Parse(Id), chosen, version))
            : Task.CompletedTask;

    private async Task Prepare(Func<int, Task<PreparationResult>> command)
    {
        if (busy || state is null)
            return;

        busy = true;
        refusal = null;

        var result = await Answered(() => command(state.Version));
        if (result is null)
        {
            busy = false;
            return;
        }

        if (result.State is { } updated)
        {
            state = updated;
            preview = [];
            KeepSelectionValid();
            // Le plateau a changé : les origines valides aussi.
            await RefreshValidOrigins();
        }
        else
        {
            refusal = result.Refusal;
            if (result.MustReload)
                await LoadState();
        }

        busy = false;
    }

    private void KeepSelectionValid()
    {
        selectedLength = ShipSelection.Keep(selectedLength, state?.Player.RemainingShipLengths ?? []);
        if (selectedLength is null || selectedPortIndex is not { } index || state is null
            || index >= state.Player.RemainingShipLengths.Count
            || state.Player.RemainingShipLengths[index] != selectedLength)
            selectedPortIndex = null;
    }

    private async Task Start()
    {
        if (busy)
            return;

        busy = true;
        starting = true;
        refusal = null;

        var result = await Answered(() => Api.StartAsync(Guid.Parse(Id)));
        if (result is null)
        {
            busy = false;
            starting = false;
            return;
        }

        if (result.Turn is { } turn)
        {
            // Le jingle et l'animation doivent être terminés avant qu'aucun coup ne soit révélé —
            // sans quoi le premier tir de l'ordinateur peut s'afficher avant que l'écran ait fini
            // de charger, et passe inaperçu.
            await PlayStartSequence();
            await AnimateTurn(turn, turn.ComputerShots.Count == 0
                ? "À toi de jouer."
                : $"L'ordinateur a commencé : {Describe(turn.ComputerShots)}",
                firstComputerShotDelay: FirstComputerShotDelay);
        }
        else
        {
            // Cas courant : un second clic sur « Commencer » pendant que le premier appel est en vol.
            refusal = result.Refusal;
            if (result.MustReload)
                await LoadState();
        }

        busy = false;
        starting = false;
    }

    // Task.Delay attend une durée fixe côté écran à chaque étape : Audio.PlayAsync ne fait que
    // lancer le son, il ne rend pas la main quand celui-ci finit de jouer (Web Audio planifie et
    // rend la main aussitôt). @key="startCountdownText" sur la bannière force un nouveau nœud DOM
    // à chaque étape, sinon l'animation CSS ne rejouerait pas pour un simple changement de texte.
    private async Task PlayStartSequence()
    {
        foreach (var (text, duration) in StartCountdownSteps)
        {
            startCountdownText = text;
            await InvokeAsync(StateHasChanged);
            await Audio.PlayAsync(text == FireWord ? "start" : "countdown-tick");
            await Task.Delay(duration);
        }

        startCountdownText = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Fire(Coordinate target)
    {
        if (busy || state is null)
            return;

        busy = true;
        refusal = null;

        // Automatique : dès que la jauge est pleine, ce tir devient l'attaque spéciale sans action
        // supplémentaire du joueur — la case visée reste le seul choix qui lui revient.
        var special = PlayerSpecialAttackCharged;
        specialAttackHover = null;

        var result = await Answered(() => Api.FireAsync(Guid.Parse(Id), target.Column, target.Row, state.Version, special));
        if (result is null)
        {
            busy = false;
            return;
        }

        if (result.Turn is { } turn)
        {
            var prefix = special ? "Attaque spéciale ! " : string.Empty;
            await AnimateTurn(turn, prefix + Describe(turn), target, playerSpecialAttack: special);
            await Audio.PlayAsync(turn.PlayerOutcome == ShotOutcome.Sunk ? "sunk" : turn.PlayerOutcome == ShotOutcome.Hit ? "hit" : "miss");
            if (turn.State.Phase == GamePhase.Finished)
                await Audio.PlayAsync(turn.State.Winner == Side.Player ? "win" : "lose");
        }
        else
        {
            refusal = result.Refusal;
            if (result.MustReload)
                await LoadState();
        }

        busy = false;
    }

    private async Task AnimateTurn(TurnDto turn, string finalMessage, Coordinate? playerTarget = null,
        TimeSpan? firstComputerShotDelay = null, bool playerSpecialAttack = false)
    {
        var previous = state!;
        animatedCell = playerTarget;
        animatedOutcome = turn.PlayerOutcome;
        animatedSpecial = playerSpecialAttack;
        state = turn.State with
        {
            Phase = previous.Phase,
            CurrentTurn = previous.CurrentTurn,
            Winner = previous.Winner,
            Player = previous.Player,
        };
        await InvokeAsync(StateHasChanged);

        for (var index = 0; index < turn.ComputerShots.Count; index++)
        {
            if (index == 0)
            {
                if (firstComputerShotDelay is { } delay)
                    await Task.Delay(delay);
            }
            else
            {
                await Task.Delay(450);
            }

            var shot = turn.ComputerShots[index];
            animatedCell = shot.Target;
            animatedOutcome = shot.Outcome;
            animatedSpecial = shot.SpecialAttack;
            // Avance avec chaque tir révélé ; se stabilise sur le dernier une fois la série finie.
            lastComputerShot = shot.Target;
            var player = state.Player;
            var misses = shot.Outcome == ShotOutcome.Miss
                ? [.. player.Misses, shot.Target]
                : player.Misses;
            var hits = shot.Outcome is ShotOutcome.Hit or ShotOutcome.Sunk
                ? [.. player.Hits, shot.Target]
                : player.Hits;
            var sunkShips = shot.Outcome == ShotOutcome.Sunk
                ? [.. player.SunkShips.Concat(turn.State.Player.SunkShips.Where(ship => ship.Contains(shot.Target)))
                    .DistinctBy(ship => string.Join(',', ship.Select(cell => $"{cell.Column}:{cell.Row}")))]
                : player.SunkShips;

            state = state with
            {
                Player = player with
                {
                    Misses = misses,
                    Hits = hits,
                    SunkShips = sunkShips,
                },
            };
            await InvokeAsync(StateHasChanged);
        }

        state = turn.State;
        // Un tir simple et une attaque spéciale de l'ordinateur produisent tous deux une liste de
        // plusieurs cases (chasse-cible qui enchaîne les touches, ou croix de 5) : sans ce signal
        // explicite venu du contrat, rien à l'écran ne les distinguait, ce qui donnait l'impression
        // que l'IA ne se servait jamais de son attaque spéciale alors qu'elle la chargeait bien.
        message = turn.ComputerShots.Any(shot => shot.SpecialAttack)
            ? $"{finalMessage} L'ordinateur a utilisé son attaque spéciale !"
            : finalMessage;
        await InvokeAsync(StateHasChanged);
    }

    private async Task NewGame()
    {
        var result = await Answered(() => Api.CreateAsync());
        if (result is null)
            return;

        if (result.Game is { } game)
        {
            Navigation.NavigateTo($"/partie/{game.Id}");
            return;
        }

        error = result.Refusal;
    }

    // Le serveur n'a pas répondu du tout : il n'y a aucun résultat à lire, et ce n'est pas un refus.
    private async Task<T?> Answered<T>(Func<Task<T>> call) where T : class
    {
        try
        {
            var result = await call();
            unreachable = null;
            return result;
        }
        catch (HttpRequestException failure)
        {
            unreachable = $"Le serveur ne répond pas : {failure.Message}";
            return null;
        }
    }

    private static string Describe(TurnDto turn)
    {
        var mine = turn.PlayerOutcome switch
        {
            ShotOutcome.Miss => "Raté.",
            ShotOutcome.Hit => "Touché.",
            ShotOutcome.Sunk => $"Coulé : {Describe(turn.SunkShip ?? [])}.",
            _ => string.Empty,
        };

        return turn.ComputerShots.Count == 0
            ? mine
            : $"{mine} L'ordinateur a joué : {Describe(turn.ComputerShots)}";
    }

    private static string Describe(IReadOnlyList<ComputerShotDto> shots) =>
        string.Join(", ", shots.Select(shot => $"{Name(shot.Target)} {Outcome(shot.Outcome)}"));

    private static string Describe(IReadOnlyList<Coordinate> cells) => string.Join(", ", cells.Select(Name));

    private static string Name(Coordinate cell) => $"{(char)('A' + cell.Column)}{cell.Row + 1}";

    private static string Outcome(ShotOutcome outcome) => outcome switch
    {
        ShotOutcome.Miss => "raté",
        ShotOutcome.Hit => "touché",
        ShotOutcome.Sunk => "coulé",
        _ => outcome.ToString(),
    };

    private static string FormatDuration(int? seconds) => seconds is not { } value
        ? "-"
        : value < 60 ? $"{value}s" : $"{value / 60}m {value % 60:00}s";

}
