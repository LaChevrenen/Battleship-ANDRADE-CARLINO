@using BattleShip.Models

@* Ce composant n'applique aucune règle : il peint les listes de cases qu'on lui donne et ignore
   à quelle grille il correspond. C'est la page qui décide ce qu'elle lui passe, y compris si
   l'aperçu est valide — cette validité vient du serveur. *@

<div class="grille" @onmouseleave="@(() => OnLeave.InvokeAsync())">
    <h2>@Title</h2>
    <table>
        <thead>
            <tr>
                <th></th>
                @for (var column = 0; column < Width; column++)
                {
                    <th>@((char)('A' + column))</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var row = 0; row < Height; row++)
            {
                var currentRow = row;
                <tr>
                    <th>@(currentRow + 1)</th>
                    @for (var column = 0; column < Width; column++)
                    {
                        var cell = new Coordinate(column, currentRow);
                        <td class="case @CssClass(cell) @HullClass(cell) @PreviewClass(cell) @(OnCellClick.HasDelegate ? "cliquable" : null)"
                            @onclick="@(() => OnCellClick.InvokeAsync(cell))"
                            @onmouseover="@(() => OnCellHover.InvokeAsync(cell))"></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public int Width { get; set; }
    [Parameter, EditorRequired] public int Height { get; set; }

    // Navires reçus groupés : c'est ce qui permet d'arrondir les bouts de coque.
    [Parameter] public IReadOnlyList<IReadOnlyList<Coordinate>> Ships { get; set; } = [];
    [Parameter] public IReadOnlyList<IReadOnlyList<Coordinate>> SunkShips { get; set; } = [];
    [Parameter] public IReadOnlyCollection<Coordinate> Misses { get; set; } = [];
    [Parameter] public IReadOnlyCollection<Coordinate> Hits { get; set; } = [];

    // Cases que la page veut mettre en évidence, et si ce placement est accepté par le serveur.
    [Parameter] public IReadOnlyCollection<Coordinate> Preview { get; set; } = [];
    [Parameter] public bool PreviewValid { get; set; }

    // Le composant signale la case cliquée ou survolée ; il ne décide jamais si l'action est permise.
    [Parameter] public EventCallback<Coordinate> OnCellClick { get; set; }
    [Parameter] public EventCallback<Coordinate> OnCellHover { get; set; }

    // Souris sortie de la grille : sans ça, le dernier aperçu resterait affiché.
    [Parameter] public EventCallback OnLeave { get; set; }

    private IEnumerable<IReadOnlyList<Coordinate>> AllShips => Ships.Concat(SunkShips);

    // Ordre d'affichage seulement : une case coulée reste touchée, une case touchée porte un navire.
    private string CssClass(Coordinate cell) =>
        SunkShips.Any(ship => ship.Contains(cell)) ? "coule"
        : Hits.Contains(cell) ? "touche"
        : Misses.Contains(cell) ? "rate"
        : Ships.Any(ship => ship.Contains(cell)) ? "navire"
        : "eau";

    // Coque : une case sans voisine du même navire dans une direction en ferme le bord de ce côté.
    private string HullClass(Coordinate cell)
    {
        var ship = AllShips.FirstOrDefault(ship => ship.Contains(cell));
        if (ship is null)
            return string.Empty;

        return HullShape.Corners(
            gauche: !ship.Contains(cell with { Column = cell.Column - 1 }),
            droite: !ship.Contains(cell with { Column = cell.Column + 1 }),
            haut: !ship.Contains(cell with { Row = cell.Row - 1 }),
            bas: !ship.Contains(cell with { Row = cell.Row + 1 }));
    }

    private string? PreviewClass(Coordinate cell) =>
        !Preview.Contains(cell) ? null : PreviewValid ? "apercu-ok" : "apercu-ko";
}
