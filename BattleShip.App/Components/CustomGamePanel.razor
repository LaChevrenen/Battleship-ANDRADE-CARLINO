@using BattleShip.Models.Dtos

@* Ce panneau ne juge rien : les bornes ci-dessous ne servent qu'à limiter les valeurs qu'on peut
   saisir dans le formulaire, elles ne remplacent pas le serveur. Une configuration qui les
   respecte peut quand même être refusée — largeur/hauteur/longueurs dupliquent GameRules côté
   serveur (BattleShip.App ne référence pas BattleShip.API), et « ne tient pas sur la grille »
   n'est tranché que par POST /games, qui peut répondre 409 FleetDoesNotFit. *@

<div class="custom-game-panel">
    <h2>Partie personnalisée</h2>

    <div class="custom-game-grid">
        <label>
            Largeur
            <input type="number" min="@MinGridSize" max="@MaxGridSize" step="1"
                   value="@width" @onchange="@(e => SetWidth(e.Value))"
                   @onwheel="@(e => AdjustWidth(e))" @onwheel:preventDefault disabled="@Busy" />
        </label>
        <label>
            Hauteur
            <input type="number" min="@MinGridSize" max="@MaxGridSize" step="1"
                   value="@height" @onchange="@(e => SetHeight(e.Value))"
                   @onwheel="@(e => AdjustHeight(e))" @onwheel:preventDefault disabled="@Busy" />
        </label>
    </div>

    <div class="custom-fleet">
        <span class="custom-fleet-title">Flotte — @TotalShips navire@(TotalShips > 1 ? "s" : "")</span>
        @foreach (var length in Lengths)
        {
            <div class="custom-fleet-row">
                <span>@length case@(length > 1 ? "s" : "")</span>
                <div class="stepper">
                    <button type="button" data-sound="stepper-down" @onclick="@(() => Decrement(length))"
                            disabled="@(Busy || counts[length] == 0)" aria-label="@($"Un {length} cases de moins")">−</button>
                    <span>@counts[length]</span>
                    <button type="button" data-sound="stepper-up" @onclick="@(() => Increment(length))"
                            disabled="@(Busy || counts[length] >= MaxShipsPerLength)" aria-label="@($"Un {length} cases de plus")">+</button>
                </div>
            </div>
        }
        @if (FleetCertainlyTooLarge)
        {
            <p class="custom-fleet-warning" role="alert">
                Cette flotte (@TotalShipCells cases) ne peut pas tenir sur une grille de
                @width × @height (@(width * height) cases).
            </p>
        }
    </div>

    <label class="custom-adjacency">
        <input type="checkbox" data-sound="checkbox" checked="@allowAdjacentShips" @onchange="@(e => allowAdjacentShips = e.Value is true)" disabled="@Busy" />
        Autoriser les navires à se toucher par un côté
    </label>

    <label class="custom-adjacency">
        <input type="checkbox" data-sound="checkbox" checked="@specialAttacksEnabled" @onchange="@(e => specialAttacksEnabled = e.Value is true)" disabled="@Busy" />
        Activer les attaques spéciales
    </label>

    <div class="custom-game-actions">
        <button type="button" class="ghost" data-sound="destructive" @onclick="Cancel" disabled="@Busy">Annuler</button>
        <button type="button" class="primary" data-sound="primary" @onclick="Submit" disabled="@(Busy || TotalShips == 0 || FleetCertainlyTooLarge)">
            @(Busy ? "Création en cours…" : "Créer la partie")
        </button>
    </div>
</div>

@code {
    // Duplique GameRules côté serveur : voir le commentaire en tête de fichier.
    private const int MinGridSize = 5;
    private const int MaxGridSize = 15;
    private const int MaxShipsPerLength = 3;
    private static readonly int[] Lengths = [1, 2, 3, 4, 5];

    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<GameCreationRequest> OnCreate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private int width = 10;
    private int height = 10;
    private bool allowAdjacentShips;
    private bool specialAttacksEnabled = true;

    // Composition de départ : la flotte classique, modifiable. Un formulaire vide obligerait à
    // tout construire soi-même avant de pouvoir créer quoi que ce soit.
    private readonly Dictionary<int, int> counts = new() { [1] = 0, [2] = 1, [3] = 2, [4] = 1, [5] = 1 };

    private int TotalShips => counts.Values.Sum();
    private int TotalShipCells => counts.Sum(pair => pair.Key * pair.Value);

    // Condition nécessaire, pas suffisante : la forme rectiligne des navires et le contact interdit
    // par défaut peuvent encore empêcher un placement même quand les cases tiennent en nombre. Le
    // serveur (POST /games, 409 FleetDoesNotFit) reste seul à trancher les cas que ce calcul laisse
    // passer ; celui-ci ne sert qu'à prévenir tout de suite les cas mathématiquement impossibles.
    private bool FleetCertainlyTooLarge => TotalShipCells > width * height;

    private void SetWidth(object? value) => width = Clamp(value, width);
    private void SetHeight(object? value) => height = Clamp(value, height);

    private static int Clamp(object? value, int fallback) =>
        value is string text && int.TryParse(text, out var parsed) ? Math.Clamp(parsed, MinGridSize, MaxGridSize) : fallback;

    // Molette au-dessus du champ : vers le haut augmente, vers le bas diminue, comme les flèches
    // natives d'un <input type="number"> mais accessibles sans viser une petite cible au pixel.
    private void AdjustWidth(WheelEventArgs e) => width = Math.Clamp(width + (e.DeltaY < 0 ? 1 : -1), MinGridSize, MaxGridSize);
    private void AdjustHeight(WheelEventArgs e) => height = Math.Clamp(height + (e.DeltaY < 0 ? 1 : -1), MinGridSize, MaxGridSize);

    private void Increment(int length)
    {
        if (counts[length] < MaxShipsPerLength)
            counts[length]++;
    }

    private void Decrement(int length)
    {
        if (counts[length] > 0)
            counts[length]--;
    }

    private Task Cancel() => OnCancel.InvokeAsync();

    private Task Submit()
    {
        var request = new GameCreationRequest(
            width, height, counts.Where(pair => pair.Value > 0).ToDictionary(), allowAdjacentShips, specialAttacksEnabled);
        return OnCreate.InvokeAsync(request);
    }
}
