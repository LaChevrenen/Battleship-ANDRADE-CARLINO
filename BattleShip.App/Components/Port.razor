@using BattleShip.Models

@* Le port : les navires qui restent à poser, dessinés à leur vraie longueur et dans l'orientation
   choisie. Un navire retiré de la grille y revient tout seul, puisque la liste vient du serveur. *@

<div class="port">
    <h2>Port</h2>
    @if (RemainingLengths.Count == 0)
    {
        <p>Flotte complète.</p>
    }
    else
    {
        <ul>
            @foreach (var length in RemainingLengths.Distinct().OrderDescending())
            {
                var choix = length;
                <li>
                    <button class="navire-port @(Orientation == Orientation.Vertical ? "vertical" : null) @(choix == SelectedLength ? "choisi" : null)"
                            title="Navire de @choix cases"
                            @onclick="@(() => OnSelect.InvokeAsync(choix))">
                        @for (var cell = 0; cell < choix; cell++)
                        {
                            <span class="case navire @HullClass(cell, choix)"></span>
                        }
                    </button>
                    <span class="reste">× @RemainingLengths.Count(remaining => remaining == choix)</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<int> RemainingLengths { get; set; } = [];
    [Parameter] public int? SelectedLength { get; set; }
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    // Mêmes classes de coque que sur la grille : seuls les bouts de la file sont arrondis.
    private string HullClass(int cell, int length) => Orientation == Orientation.Horizontal
        ? $"bout-h bout-b {(cell == 0 ? "bout-g" : null)} {(cell == length - 1 ? "bout-d" : null)}"
        : $"bout-g bout-d {(cell == 0 ? "bout-h" : null)} {(cell == length - 1 ? "bout-b" : null)}";
}
