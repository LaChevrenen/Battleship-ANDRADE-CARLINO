@using BattleShip.App.Services
@inject GameAudio Audio

<div class="nav-shell">
    <div class="brand-block">
        <div class="brand-mark">⚓</div>
        <div>
            <p class="eyebrow">jeu</p>
            <h1>Bataille navale</h1>
        </div>
    </div>

    <nav class="nav-stack">
        <NavLink class="nav-link" data-sound="nav" href="" Match="NavLinkMatch.All">
            <span aria-hidden="true">⌂</span>
            <span>Accueil</span>
        </NavLink>
    </nav>

    @* Dans la barre latérale : elle entoure toutes les pages, donc l'audio se règle partout. *@
    <div class="nav-audio" aria-label="Réglages audio">
        <span class="nav-audio-title">Audio</span>
        <label class="sound-toggle">
            <input type="checkbox" data-sound="checkbox" checked="@Audio.SoundEnabled" @onchange="ToggleSound" /> Sons
        </label>
        <label class="sound-toggle">
            <input type="checkbox" data-sound="checkbox" checked="@Audio.MusicEnabled" @onchange="ToggleMusic" /> Musique
        </label>
    </div>

    <div class="nav-footer">
        <p>partie en ligne</p>
        <span>serveur autoritaire</span>
    </div>
</div>

@code {
    private void ToggleSound(ChangeEventArgs change) => Audio.SetSound(change.Value is true);

    private Task ToggleMusic(ChangeEventArgs change) => Audio.SetMusicAsync(change.Value is true);
}
